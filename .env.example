DATABASE_URL="postgresql://user:password@localhost:5433/guestflow_db?schema=public"
NEXTAUTH_SECRET="your-super-secret-key-for-nextauth"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Cloud API Integration
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_business_account_id"
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_secure_webhook_verify_token"
META_APP_SECRET="your_meta_app_secret_for_webhooks"

# Automation
AUTOMATION_CRON_SECRET="your_cron_secret_key"

# E2E test credentials (runtime-only — never commit real values)
# Required by tests/ and scripts/measure-perf.ts; tests fail clearly if unset.
E2E_ADMIN_EMAIL="admin@example.com"
E2E_ADMIN_PASSWORD="replace-with-runtime-secret"
E2E_RECEPTION_EMAIL="reception@example.com"
E2E_RECEPTION_PASSWORD="replace-with-runtime-secret"
